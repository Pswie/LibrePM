# Backend environment only. Java does not automatically load this file.
# This opt-in profile includes `cloud`: Clerk and the existing authorization stay active.
SPRING_PROFILES_ACTIVE=cloud-postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
SPRING_DATASOURCE_USERNAME=librepm_app
SPRING_DATASOURCE_PASSWORD=
# Schema owner/migrator credentials are separate from the runtime DML role.
# Direct/session connections support Flyway; avoid transaction-mode poolers for migrations.
LIBREPM_MIGRATION_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.crt
LIBREPM_MIGRATION_USERNAME=librepm_owner
LIBREPM_MIGRATION_PASSWORD=
DB_POOL_MAX=3
DB_POOL_MIN=0
CLERK_ISSUER_URI=
CLERK_AUDIENCE=
CORS_ALLOWED_ORIGINS=
# Keep all existing SUITE_* server settings; see .env.suite.example.
