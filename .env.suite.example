# Example only. Set these in the backend process environment; Spring does not load .env automatically.
SUITE_ENABLED=false
SUITE_ORGANIZATION_ID=
SUITE_LIBREPM_API_URL=
SUITE_ASSOCIAGO_API_URL=
SUITE_BANDI_API_URL=
SUITE_LIBREPM_PUBLIC_URL=
SUITE_ASSOCIAGO_PUBLIC_URL=
SUITE_BANDI_PUBLIC_URL=
# Distinct random server-only keys, at least 32 characters each. Leave real values out of Git.
SUITE_ASSOCIAGO_KEY=
SUITE_BANDI_KEY=
# Existing real LibrePM user UUID, only needed when the source actor has no linked Clerk user.
SUITE_IMPORT_OWNER_ID=
SUITE_SYNC_INTERVAL_MS=300000
SUITE_SYNC_INITIAL_DELAY_MS=60000
